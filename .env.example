# Скопируйте в .env.local и заполните из Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Только для серверных скриптов (сидинг вопросов). Никогда не коммитьте и не используйте в клиенте.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Этап 2: Telegram-бот для напоминаний
TELEGRAM_BOT_TOKEN=
CRON_SECRET=
